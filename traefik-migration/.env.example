# Traefik DNS Provider Credentials
# Copy this file to .env and fill in your actual values

# Porkbun (for *.amn.gg, *.tbs.amn.gg)
# You need BOTH the API Key AND the Secret API Key from https://porkbun.com/account/api
PORKBUN_API_KEY=pk1_xxxxxxxxxxxxxxxx
PORKBUN_SECRET_API_KEY=sk1_xxxxxxxxxxxxxxxx

# Cloudflare (for *.manko.yoga and future domains)
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:Read + DNS:Edit for your zones
CF_DNS_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Newt (Pangolin tunnel) — keep existing values from current proxy project
NEWT_ID=YOUR_NEWT_ID
NEWT_SECRET=YOUR_NEWT_SECRET
